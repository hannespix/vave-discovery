{
  "permissions": {
    "allow": [
      "Bash(npm run check*)",
      "Bash(node scripts/check.mjs*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git worktree*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git merge*)"
    ],
    "deny": [
      "Edit(data/results/**)",
      "Write(data/results/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node scripts/check.mjs --hook"
          }
        ]
      }
    ]
  }
}
