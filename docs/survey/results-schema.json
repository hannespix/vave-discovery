{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vave-discovery — Umfrage-Ergebnis",
  "description": "Ausgabe von survey/index.html. Eine Datei pro Befragung. zone 'skip' ist die Neutraloption (weiß nicht / betrifft mich nicht) und wird bei allen Berechnungen ignoriert.",
  "type": "object",
  "required": ["meta", "modules", "missing", "budget", "wand"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schemaVersion", "surveyVersion", "target", "respondent", "role", "completedAt", "durationSec"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "surveyVersion": { "type": "string", "description": "git describe der Umfrage-Datei" },
        "target": { "enum": ["quojob", "prototype"], "description": "Was wird bewertet — Bestand (M1) oder Prototyp (M4)" },
        "respondent": { "type": "string" },
        "role": { "enum": ["gf", "pm", "kreation", "backoffice", "asia"] },
        "completedAt": { "type": "string", "format": "date-time" },
        "durationSec": { "type": "integer", "minimum": 0 },
        "device": { "type": "string" }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "zone"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "id aus modules.json" },
          "zone": { "enum": ["keep", "kill", "miss", "skip"] },
          "frust": { "type": ["integer", "null"], "minimum": 0, "maximum": 5, "description": "nur bei zone=keep; Skala: wie oft bremst es (0 nie … 5 täglich)" },
          "roles": { "type": "array", "items": { "enum": ["gf", "pm", "kreation", "backoffice", "asia"] }, "description": "wer nutzt es bei VAVE tatsächlich" }
        }
      }
    },
    "missing": {
      "type": "array",
      "description": "Vermisstes — aus Zone miss und/oder Freitext, in Prioritätsreihenfolge",
      "items": {
        "type": "object",
        "required": ["label", "priority"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1 },
          "moduleId": { "type": ["string", "null"] }
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["currentMonthlyEur", "painThresholdEur", "buildWillingness"],
      "additionalProperties": false,
      "properties": {
        "currentMonthlyEur": { "type": ["number", "null"], "minimum": 0, "description": "heutige Kosten für Agentursoftware, null = weiß nicht" },
        "painThresholdEur": { "type": ["number", "null"], "minimum": 0, "description": "monatliche Schmerzgrenze für eine bessere Lösung" },
        "buildWillingness": { "type": "integer", "minimum": 0, "maximum": 10, "description": "Bereitschaft, Eigenentwicklung zu tragen (Pflege, Verantwortung)" }
      }
    },
    "wand": { "type": "string", "description": "Zauberstab-Freitext, wörtlich" }
  }
}
