{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vave-discovery — Umfrage-Export (schema vave-discovery/1)",
  "description": "Exakt das, was survey/index.html per Download erzeugt. Modul-, Wunsch- und Rollen-IDs stammen aus survey/modules.js. Zone 'unknown' (Kenne ich nicht) ist die Neutraloption und wird bei allen Berechnungen ignoriert. Reibung (friction) nur für Module in Zone 'keep', Skala 0 (läuft rund) … 4 (bremst täglich).",
  "type": "object",
  "required": ["schema", "exportedAt", "startedAt", "respondent", "sort", "friction", "wishes", "customWishes", "roles", "budget", "wand", "noGo", "hypothesis"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "vave-discovery/1" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": "string", "format": "date-time" },
    "respondent": { "type": "string", "minLength": 1 },
    "sort": {
      "type": "object",
      "description": "moduleId → Zone",
      "additionalProperties": { "enum": ["keep", "drop", "unknown"] }
    },
    "friction": {
      "type": "object",
      "description": "moduleId → Reibung 0–4, nur für Zone keep",
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 4 }
    },
    "wishes": {
      "type": "object",
      "description": "wishId → Stufe",
      "additionalProperties": { "enum": ["off", "nice", "must"] }
    },
    "customWishes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "level"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string", "minLength": 1 },
          "level": { "enum": ["off", "nice", "must"] }
        }
      }
    },
    "roles": {
      "type": "object",
      "description": "roleId → Nutzungshäufigkeit",
      "additionalProperties": { "enum": ["never", "rarely", "weekly", "daily"] }
    },
    "budget": {
      "type": "object",
      "required": ["current", "currentUnknown", "max", "buildBuy"],
      "additionalProperties": false,
      "properties": {
        "current": { "type": "number", "minimum": 0, "maximum": 6000, "description": "heutige Kosten €/Monat; nur gültig, wenn currentUnknown=false" },
        "currentUnknown": { "type": "boolean" },
        "max": { "type": "number", "minimum": 0, "description": "Schmerzgrenze €/Monat" },
        "buildBuy": { "type": "integer", "minimum": 0, "maximum": 100, "description": "0 = fertiges Tool kaufen … 100 = selbst bauen lassen" }
      }
    },
    "wand": { "type": "string", "description": "Zauberstab, wörtlich" },
    "noGo": { "type": "string", "description": "Darf nicht passieren, wörtlich" },
    "hypothesis": {
      "type": "object",
      "description": "Von der Umfrage selbst berechnet (hypothesis() in index.html). Hinweis für Menschen, kein Urteil — der gatekeeper rechnet unabhängig nach.",
      "required": ["target", "reasons"],
      "additionalProperties": false,
      "properties": {
        "target": { "enum": ["A", "B", "C"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
